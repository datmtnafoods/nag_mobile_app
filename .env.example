# === CHỌN MODE ===
# Mock mode (1): không cần backend, login bằng admin/123456 hoặc npp/123456
# Real mode (0 hoặc để trống): gọi backend thật ở EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_MOCK_API=1

# Backend NaGreen ERP API (dùng khi MOCK_API=0)
# Thay <LAN-IP> bằng IP máy dev khi test trên điện thoại thật (chạy `ipconfig` trên Windows để xem)
EXPO_PUBLIC_API_BASE_URL=http://<LAN-IP>:5000

# WebSocket cho chat/inbox (Phase 3)
EXPO_PUBLIC_WS_URL=ws://<LAN-IP>:5000

# Vision service (Phase 4)
EXPO_PUBLIC_VISION_URL=http://<LAN-IP>:8000
